# GitHub API Token (Optional: used for live GitHub issue & repository lookups)
# Can be a Personal Access Token (classic or fine-grained) with 'repo' read scope
GITHUB_TOKEN=your_github_token_here

# LLM API Keys (Optional: if omitted, assistant runs in high-performance local demo mode)
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Workspace Jail Root Directory (Optional: defaults to repository root)
WORKSPACE_DIR=
